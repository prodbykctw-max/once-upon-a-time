# Dependencies
node_modules/

# Build output
dist/

# Vite cache
.vite/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs
npm-debug.log*
*.log

# Env (if you add EmailJS keys later)
.env
.env.local

# Never commit: real-person reference photos + 3D source assets (public repo) + session config
assets/
.claude/

tools/captures/

# stray debug frame grabs dropped in the repo root
image-*.jpg
image-*.png

# wrangler local state (deploy cache) — never commit
.wrangler/
cloudflare/.wrangler/

# FRÉDÉRIC EDITION — generated from index.html by tools/build_fred.py at
# deploy time. One source of truth; never edit or commit the output.
fred/

# Python bytecode — created when tools/depth modules import each other
__pycache__/
*.pyc

# Atlanta world build — raw OSM extracts (large, re-fetchable, not ours to vendor)
tools/atlanta/cache/
tools/atlanta/art/pbr/

# Rendered presentation video. Regenerated by tools/atlanta/present/render.cjs;
# ~40 MB a set and it changes whenever the world or the routes change.
presentation/video/

# Aerial imagery: public-domain USGS NAIP, refetched by fetch_aerial.mjs.
# ~23 MB a set and regenerable, so it is not committed. The georeference JSON
# beside each image IS committed, because it is the thing that places it.
tools/atlanta/art/aerial/*.jpg
